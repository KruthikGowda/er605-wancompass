[Unit]
Description=Recover an interrupted ER605 compatibility trial
Wants=network-online.target
After=network-online.target
Before=netpulse.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=netpulse
WorkingDirectory=/opt/netpulse
Environment=PYTHONPATH=/opt/netpulse
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B -m tools.router_compat_trial --recover-on-boot
TimeoutStartSec=150
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=-/var/lib/netpulse
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
